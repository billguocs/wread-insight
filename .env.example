# 复制为 .env 并填入真实值
PORT=8787
NODE_ENV=development
LOG_LEVEL=info

# 可选：仅用于首次启动时自动迁移为默认档案。
# 正常情况无需配置——启动后打开网页，在引导页粘贴 Key 即可接入（支持多账号）。
WEREAD_API_KEY=wrk-xxxxxxxx
WEREAD_GATEWAY=https://i.weread.qq.com/api/agent/gateway
WEREAD_SKILL_VERSION=1.0.5

DOUBAN_ENABLED=true
DOUBAN_CONCURRENCY=2
DOUBAN_MIN_INTERVAL_MS=350
DOUBAN_CACHE_TTL_HOURS=720

QUICK_SYNC_TTL_MINUTES=10
FULL_SYNC_TTL_HOURS=12
SYNC_MONTH_WINDOW=24
SYNC_WEEK_WINDOW=12

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173